# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# arXiv
ARXIV_MAX_RESULTS=10
ARXIV_LOOKBACK_DAYS=7

# Email (QQ SMTP)
# SMTP_USE_SSL=1: use SSL on port 465
# SMTP_USE_SSL=0: use STARTTLS on port 587 (if 465 is blocked by firewall)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=1
SENDER_EMAIL=your-email@qq.com
SENDER_AUTH_CODE=your-auth-code
RECEIVER_EMAIL=your-email@gmail.com

# Logging (server mode: quiet + file)
# QUIET=1
# LOG_FILE=digest.log
